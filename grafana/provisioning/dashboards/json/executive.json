        "pieType": "pie",
        "displayLabels": ["name", "percent"],
        "legend": { "displayMode": "list", "placement": "bottom", "values": ["value"] },
        "reduceOptions": { "calcs": [], "values": true, "fields": "" }
      },
      "targets": [
        { "refId": "A", "queryType": "sql", "format": 1,
          "rawSql": "SELECT Channel, Tickets FROM v_tickets_by_channel ORDER BY Tickets DESC",
          "datasource": { "type": "grafana-clickhouse-datasource" } }
      ]
    },
    {
      "id": 8, "type": "piechart", "title": "Por categoría",
      "gridPos": { "x": 18, "y": 4, "w": 6, "h": 8 },
      "datasource": { "type": "grafana-clickhouse-datasource" },
