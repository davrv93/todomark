      "targets": [
        { "refId": "A", "queryType": "sql", "format": 1,
          "rawSql": "SELECT Category, Tickets FROM v_tickets_by_category ORDER BY Tickets DESC",
          "datasource": { "type": "grafana-clickhouse-datasource" } }
      ]
    },
    {
      "id": 9, "type": "table", "title": "Top edificios (demo) — volumen y MTTR",
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
      "datasource": { "type": "grafana-clickhouse-datasource" },
      "fieldConfig": { "defaults": { "decimals": 1 }, "overrides": [] },
      "targets": [
        { "refId": "A", "queryType": "sql", "format": 1,
          "rawSql": "SELECT BuildingID, Tickets, AvgResolutionHours FROM v_tickets_by_building ORDER BY Tickets DESC",
          "datasource": { "type": "grafana-clickhouse-datasource" } }
