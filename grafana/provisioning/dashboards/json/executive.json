{
  "uid": "todomark-executive",
  "title": "TodoMark — Ejecutivo (ClickHouse)",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 5,
  "refresh": "30s",
  "time": { "from": "now-90d", "to": "now" },
  "panels": [
    {
      "id": 1, "type": "stat", "title": "Tickets totales",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "grafana-clickhouse-datasource" },
      "targets": [
        { "refId": "A", "queryType": "sql", "format": 1,
          "rawSql": "SELECT count() AS TicketsTotales FROM fact_tickets",
          "datasource": { "type": "grafana-clickhouse-datasource" } }
      ]
    },
    {
      "id": 2, "type": "stat", "title": "Tickets abiertos",
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "grafana-clickhouse-datasource" },
      "targets": [
        { "refId": "A", "queryType": "sql", "format": 1,
          "rawSql": "SELECT count() AS Abiertos FROM fact_tickets WHERE Status IN ('open','in_progress','reopened')",
          "datasource": { "type": "grafana-clickhouse-datasource" } }
      ]
    },
    {
      "id": 3, "type": "stat", "title": "MTTR global (horas)",
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "grafana-clickhouse-datasource" },
      "fieldConfig": { "defaults": { "decimals": 1 }, "overrides": [] },
      "targets": [
        { "refId": "A", "queryType": "sql", "format": 1,
          "rawSql": "SELECT avgIf((toUnixTimestamp(ClosedAt) - toUnixTimestamp(CreatedAt)) / 3600, ClosedAt IS NOT NULL) AS MTTRHoras FROM fact_tickets",
          "datasource": { "type": "grafana-clickhouse-datasource" } }
      ]
    },
    {
      "id": 4, "type": "stat", "title": "CSAT promedio (1-5)",
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "grafana-clickhouse-datasource" },
      "fieldConfig": { "defaults": { "decimals": 1 }, "overrides": [] },
      "targets": [
        { "refId": "A", "queryType": "sql", "format": 1,
          "rawSql": "SELECT CSATAvg FROM v_csat",
          "datasource": { "type": "grafana-clickhouse-datasource" } }
      ]
    },
    {
      "id": 5, "type": "piechart", "title": "Por estado",
      "gridPos": { "x": 0, "y": 4, "w": 6, "h": 8 },
      "datasource": { "type": "grafana-clickhouse-datasource" },
      "options": {
        "pieType": "donut",
        "displayLabels": ["name", "percent"],
        "legend": { "displayMode": "list", "placement": "bottom", "values": ["value"] },
        "reduceOptions": { "calcs": [], "values": true, "fields": "" }
      },
      "targets": [
        { "refId": "A", "queryType": "sql", "format": 1,
          "rawSql": "SELECT Status, Tickets FROM v_tickets_by_status ORDER BY Tickets DESC",
          "datasource": { "type": "grafana-clickhouse-datasource" } }
      ]
    },
    {
      "id": 6, "type": "piechart", "title": "Por prioridad",
      "gridPos": { "x": 6, "y": 4, "w": 6, "h": 8 },
      "datasource": { "type": "grafana-clickhouse-datasource" },
      "options": {
        "pieType": "donut",
        "displayLabels": ["name", "percent"],
        "legend": { "displayMode": "list", "placement": "bottom", "values": ["value"] },
        "reduceOptions": { "calcs": [], "values": true, "fields": "" }
      },
      "targets": [
        { "refId": "A", "queryType": "sql", "format": 1,
          "rawSql": "SELECT Priority, Tickets FROM v_tickets_by_priority ORDER BY Tickets DESC",
          "datasource": { "type": "grafana-clickhouse-datasource" } }
      ]
    },
    {
      "id": 7, "type": "piechart", "title": "Por canal",
      "gridPos": { "x": 12, "y": 4, "w": 6, "h": 8 },
      "datasource": { "type": "grafana-clickhouse-datasource" },
